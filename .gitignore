# secrets: every .env variant, except the versioned template
.env*
!.env.example
# everything under data/ stays out of Git: the official PDFs (downloaded by hand), the French OCR
# model, hand transcriptions of OCR pages and the evaluation cases quote or hold the doctrine;
# only the fingerprint of the frozen test split is versioned (eval/frozen-test.sha256)
data/
# python and build output
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
# report written by `collect check --report` (corpus watch)
/report.md
.DS_Store
# local learning profile (VibeWise), personal to each developer
.vibe-wise/
