# Copy to .env (ignored by Git) and fill in; the environment, when set, takes precedence.
# Mistral API key: OCR, embeddings and, later, answers. Never commit the real key.
MISTRAL_API_KEY=
# Local Postgres (Homebrew). The tests use TEST_DATABASE_URL, a database ending in _test.
DATABASE_URL=postgresql:///secours_tech

# Docker Compose only (compose.yaml): the superuser of the local Postgres container and the
# pipeline's own role, for example `openssl rand -hex 16` each. DB_PORT is the loopback port.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DB_PORT=5433
